$TTL 86400
@   IN  SOA ns1.ccdcteam01.internal. admin.ccdcteam01.internal. (
            01        ; Serial
            604800    ; Refresh
            86400     ; Retry
            2419200   ; Expire
            86400 )   ; Negative Cache TTL
;
@       IN  NS      ns1.ccdcteam01.internal.

ns1     IN  A       172.20.240.20    ; Current DNS server
docker  IN  A       172.20.240.10    ; Docker server
