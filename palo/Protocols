###############################################################
# 2. DISABLE IMMEDIATELY - PALO
###############################################################
configure

set deviceconfig system service disable-telnet yes
set deviceconfig system service disable-http yes
set deviceconfig system service disable-snmp yes

set deviceconfig system permitted-ip <your-admin-ip>

# Create strong crypto profiles
set network ike crypto-profiles ike-crypto-profiles CCDC-IKE authentication sha256
set network ike crypto-profiles ike-crypto-profiles CCDC-IKE encryption aes-256-cbc
set network ike crypto-profiles ike-crypto-profiles CCDC-IKE dh-group group14

set network ike crypto-profiles ipsec-crypto-profiles CCDC-IPSEC esp authentication sha256
set network ike crypto-profiles ipsec-crypto-profiles CCDC-IPSEC esp encryption aes-256-cbc
set network ike crypto-profiles ipsec-crypto-profiles CCDC-IPSEC dh-group group14

commit
exit

##Manual Checks
show running nat-policy
show network ike crypto-profiles ike-crypto-profiles
show network ike crypto-profiles ipsec-crypto-profiles

##If NAT exposes sus ports
configure
delete rulebase nat rules <rule-name>
commit
exit

##Verify
nmap -sV -Pn <palo-alto-ip>
